## Parte 2: Blindaje Absoluto de Arranque para que los Motores 4, 5 y 6 No Fallen Jamás

Para garantizar que ninguno de los motores arroje errores de inicialización (`AMEDIA_ERROR_UNSUPPORTED`, `EGL_BAD_ALLOC`, desincronización de geometría o bloqueo de buffers) al arrancar el stream de xCloud, debes incorporar estos **5 mecanismos críticos** en tu capa de pre-inyección:

### 2.1 Lector de Bitstream Exp-Golomb del `SPS` (Evita crasheos cuando xCloud arranca en 720p o 900p)

**El problema:** Si inicializas `AImageReader` y `AMediaCodec` asumiendo siempre `1920x1080`, pero el servidor de Azure arranca la sesión en `1280x720` (común en juegos de Xbox Series S o durante los primeros segundos de adaptación de ancho de banda), los Motores 4, 5 y 6 fallarán al mapear los `AHardwareBuffer` o mostrarán un cuarto de la pantalla en verde.
**La solución:** Antes de llamar a `configureCsd()`, extrae la resolución real leyendo los campos `pic_width_in_mbs_minus1` y `pic_height_in_map_units_minus1` directamente del paquete `SPS` mediante decodificación **Exponential-Golomb**:

```cpp
#include <cstdint>
#include <vector>

class SpsDimensionExtractor {
    const uint8_t* data;
    size_t bitPos = 0;
    size_t totalBits;

    uint32_t readBit() {
        if (bitPos >= totalBits) return 0;
        uint32_t bit = (data[bitPos >> 3] >> (7 - (bitPos & 7))) & 1;
        bitPos++;
        return bit;
    }

    uint32_t readBits(int n) {
        uint32_t val = 0;
        for (int i = 0; i < n; ++i) val = (val << 1) | readBit();
        return val;
    }

    uint32_t readUe() {
        int leadingZeros = 0;
        while (readBit() == 0 && bitPos < totalBits && leadingZeros < 32) {
            leadingZeros++;
        }
        return (1U << leadingZeros) - 1U + readBits(leadingZeros);
    }

    int32_t readSe() {
        uint32_t ue = readUe();
        return (ue & 1) ? static_cast<int32_t>((ue + 1) >> 1) : -static_cast<int32_t>(ue >> 1);
    }

public:
    // Elimina los bytes de Emulation Prevention (0x00 0x00 0x03 -> 0x00 0x00) y extrae Ancho x Alto exactos
    static bool parseAnnexBSps(const uint8_t* spsAnnexB, size_t len, int& outWidth, int& outHeight) {
        if (len < 8) return false;

        // Saltar start code (00 00 00 01) y byte de cabecera NAL (0x67)
        std::vector<uint8_t> rbsp;
        rbsp.reserve(len);
        for (size_t i = 5; i < len; ++i) {
            if (i + 2 < len && spsAnnexB[i] == 0x00 && spsAnnexB[i+1] == 0x00 && spsAnnexB[i+2] == 0x03) {
                rbsp.push_back(0x00);
                rbsp.push_back(0x00);
                i += 2; // Omitir el byte 0x03
            } else {
                rbsp.push_back(spsAnnexB[i]);
            }
        }

        SpsDimensionExtractor reader{rbsp.data(), 0, rbsp.size() * 8};
        uint32_t profileIdc = reader.readBits(8);
        reader.readBits(16); // constraint flags + level_idc
        reader.readUe();     // seq_parameter_set_id

        if (profileIdc == 100 || profileIdc == 110 || profileIdc == 122 || profileIdc == 244 ||
            profileIdc == 44  || profileIdc == 83  || profileIdc == 86  || profileIdc == 118) {
            uint32_t chromaFormatIdc = reader.readUe();
            if (chromaFormatIdc == 3) reader.readBit();
            reader.readUe(); // bit_depth_luma_minus8
            reader.readUe(); // bit_depth_chroma_minus8
            reader.readBit(); // qpprime_y_zero_transform_bypass_flag
            if (reader.readBit()) { // seq_scaling_matrix_present_flag
                for (int i = 0; i < ((chromaFormatIdc != 3) ? 8 : 12); ++i) {
                    if (reader.readBit()) { /* omitir matriz de escalado si existe */ }
                }
            }
        }

        reader.readUe(); // log2_max_frame_num_minus4
        uint32_t picOrderCntType = reader.readUe();
        if (picOrderCntType == 0) {
            reader.readUe();
        } else if (picOrderCntType == 1) {
            reader.readBit();
            reader.readSe();
            reader.readSe();
            uint32_t numRefFramesInPicOrderCnt = reader.readUe();
            for (uint32_t i = 0; i < numRefFramesInPicOrderCnt; ++i) reader.readSe();
        }

        reader.readUe(); // max_num_ref_frames
        reader.readBit(); // gaps_in_frame_num_value_allowed_flag

        uint32_t picWidthInMbs = reader.readUe() + 1;
        uint32_t picHeightInMapUnits = reader.readUe() + 1;
        uint32_t frameMbsOnlyFlag = reader.readBit();
        if (!frameMbsOnlyFlag) reader.readBit();
        reader.readBit(); // direct_8x8_inference_flag

        uint32_t cropLeft = 0, cropRight = 0, cropTop = 0, cropBottom = 0;
        if (reader.readBit()) { // frame_cropping_flag
            cropLeft   = reader.readUe();
            cropRight  = reader.readUe();
            cropTop    = reader.readUe();
            cropBottom = reader.readUe();
        }

        outWidth  = static_cast<int>(picWidthInMbs * 16 - (cropLeft + cropRight) * 2);
        outHeight = static_cast<int>((2 - frameMbsOnlyFlag) * picHeightInMapUnits * 16 - (cropTop + cropBottom) * 2);
        return (outWidth > 0 && outHeight > 0);
    }
};

