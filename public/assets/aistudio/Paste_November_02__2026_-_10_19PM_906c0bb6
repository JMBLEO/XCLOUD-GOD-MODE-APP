### 1.2 Contrato Unificado y Enrutador JNI para los Motores 4, 5 y 6 (C++20)

El despachador expone una interfaz común `IExtendedRenderNode` que recibe las unidades de acceso (Access Units Annex-B completas) desde el hilo receptor del protocolo Nano/SRTP.

```cpp
#include <jni.h>
#include <android/native_window_jni.h>
#include <cstdint>
#include <memory>
#include <mutex>

struct StreamCropInfo {
    int32_t left = 0;
    int32_t top = 0;
    int32_t right = 1919;
    int32_t bottom = 1079;
    int32_t codedWidth = 1920;
    int32_t codedHeight = 1080;
};

class IExtendedRenderNode {
public:
    virtual ~IExtendedRenderNode() = default;
    virtual bool mount(ANativeWindow* hostWindow, int displayW, int displayH, bool enableAi) = 0;
    virtual void configureCsd(const uint8_t* sps, size_t spsSize, const uint8_t* pps, size_t ppsSize, int streamW, int streamH) = 0;
    virtual void submitAccessUnit(const uint8_t* auData, size_t auSize, uint64_t ptsUs, bool isKeyframe) = 0;
    virtual void updateDisplaySize(int width, int height) = 0;
    virtual void unmount() = 0;
};

std::unique_ptr<IExtendedRenderNode> buildMotor4HwcSurfaceTransaction();
std::unique_ptr<IExtendedRenderNode> buildMotor5MediaCodecNpuAi();
std::unique_ptr<IExtendedRenderNode> buildMotor6MediaCodecEglOesAi();

namespace {
    std::mutex g_routerMutex;
    ANativeWindow* g_hostWindow = nullptr;
    std::unique_ptr<IExtendedRenderNode> g_activeNode = nullptr;
}

extern "C" JNIEXPORT void JNICALL
Java_com_godmode_xcloud_barestream_BareStreamExtendedActivity_nativeMountEngine(
        JNIEnv* env, jobject /*thiz*/, jobject surface, jint engineSlot,
        jint displayW, jint displayH, jboolean useAi) {
    std::lock_guard<std::mutex> lock(g_routerMutex);

    if (g_activeNode) {
        g_activeNode->unmount();
        g_activeNode.reset();
    }
    if (g_hostWindow) {
        ANativeWindow_release(g_hostWindow);
        g_hostWindow = nullptr;
    }

    g_hostWindow = ANativeWindow_fromSurface(env, surface);
    if (!g_hostWindow) return;

    switch (engineSlot) {
        case 4:
            g_activeNode = buildMotor4HwcSurfaceTransaction();
            break;
        case 5:
            g_activeNode = buildMotor5MediaCodecNpuAi();
            break;
        case 6:
        default:
            g_activeNode = buildMotor6MediaCodecEglOesAi();
            break;
    }

    g_activeNode->mount(g_hostWindow, displayW, displayH, static_cast<bool>(useAi));
}

extern "C" JNIEXPORT void JNICALL
Java_com_godmode_xcloud_barestream_BareStreamExtendedActivity_nativeUpdateDimensions(
        JNIEnv* /*env*/, jobject /*thiz*/, jint width, jint height) {
    std::lock_guard<std::mutex> lock(g_routerMutex);
    if (g_activeNode) {
        g_activeNode->updateDisplaySize(width, height);
    }
}

extern "C" JNIEXPORT void JNICALL
Java_com_godmode_xcloud_barestream_BareStreamExtendedActivity_nativeUnmountEngine(
        JNIEnv* /*env*/, jobject /*thiz*/) {
    std::lock_guard<std::mutex> lock(g_routerMutex);
    if (g_activeNode) {
        g_activeNode->unmount();
        g_activeNode.reset();
    }
    if (g_hostWindow) {
        ANativeWindow_release(g_hostWindow);
        g_hostWindow = nullptr;
    }
}

