La integración de los **Motores 4, 5 y 6** amplía la arquitectura nativa con tres rutas de ejecución adicionales diseñadas para operar en **Estado 0** (únicamente el lienzo de video a pantalla completa, sin controles superpuestos, sin telemetría visual, sin menús, sin `WebView` y sin `FFmpeg`).

Mientras que los Motores 1, 2 y 3 se centraron en Vulkan puro y cómputo en GPU, estos tres nuevos motores explotan **el compositor de pantalla físico (`ASurfaceTransaction` / HWC2)**, **el procesador neuronal dedicado (`NPU` vía Android NNAPI con DMA-BUF Zero-Copy)** y **el bus nativo `EGLImageKHR` + `samplerExternalOES**` para garantizar compatibilidad universal e inyección de **MediaCodec + AI Upscaling** en cualquier SoC Android.

---

## Parte 1: Proceso de Inyección en Estado 0 (Motores 4, 5 y 6)

### 1.1 Actividad en Estado 0 con Soporte de `SurfaceControl` NDK (Kotlin)

Esta actividad crea exclusivamente un `SurfaceView` desnudo, oculta las barras del sistema operativo y transfiere tanto el `Surface` como las dimensiones físicas del panel al orquestador nativo.

```kotlin
package com.godmode.xcloud.barestream

import android.app.Activity
import android.os.Bundle
import android.view.Surface
import android.view.SurfaceHolder
import android.view.SurfaceView
import android.view.WindowManager
import androidx.core.view.WindowCompat
import androidx.core.view.WindowInsetsCompat
import androidx.core.view.WindowInsetsControllerCompat

enum class ExtendedEngineSlot(val code: Int) {
    // Motor 4: AMediaCodec -> ASurfaceTransaction (HWC2 Directo) + Vendor DPU AI Upscaler
    MOTOR_4_HWC2_SURFACE_TRANSACTION_AI(4),
    // Motor 5: AMediaCodec -> AHardwareBuffer -> NPU NNAPI AI Upscaler -> ANativeWindow
    MOTOR_5_MEDIACODEC_NPU_NNAPI_AI(5),
    // Motor 6: AMediaCodec -> EGLImageKHR Zero-Copy -> GLES 3.2 External OES AI Shader
    MOTOR_6_MEDIACODEC_EGLIMAGE_OES_AI(6)
}

class BareStreamExtendedActivity : Activity(), SurfaceHolder.Callback2 {

    companion object {
        init {
            System.loadLibrary("godmode_extended_engines")
        }
    }

    private lateinit var streamCanvas: SurfaceView
    private var activeSlot: ExtendedEngineSlot = ExtendedEngineSlot.MOTOR_4_HWC2_SURFACE_TRANSACTION_AI
    private var aiUpscaleActive: Boolean = true

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
        WindowCompat.setDecorFitsSystemWindows(window, false)
        WindowInsetsControllerCompat(window, window.decorView).apply {
            hide(WindowInsetsCompat.Type.systemBars())
            systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
        }

        val slotCode = intent.getIntExtra("STREAM_ENGINE_SLOT", 4)
        activeSlot = ExtendedEngineSlot.entries.firstOrNull { it.code == slotCode }
            ?: ExtendedEngineSlot.MOTOR_4_HWC2_SURFACE_TRANSACTION_AI
        aiUpscaleActive = intent.getBooleanExtra("ENABLE_AI_UPSCALING", true)

        // Lienzo en 0: sin layouts adicionales ni capas de interfaz
        streamCanvas = SurfaceView(this)
        streamCanvas.holder.addCallback(this)
        setContentView(streamCanvas)
    }

    override fun surfaceCreated(holder: SurfaceHolder) {
        val bounds = holder.surfaceFrame
        nativeMountEngine(
            surface = holder.surface,
            engineSlot = activeSlot.code,
            displayW = bounds.width(),
            displayH = bounds.height(),
            useAi = aiUpscaleActive
        )
    }

    override fun surfaceChanged(holder: SurfaceHolder, format: Int, width: Int, height: Int) {
        nativeUpdateDimensions(width, height)
    }

    override fun surfaceRedrawNeeded(holder: SurfaceHolder) {}

    override fun surfaceDestroyed(holder: SurfaceHolder) {
        nativeUnmountEngine()
    }

    private external fun nativeMountEngine(
        surface: Surface,
        engineSlot: Int,
        displayW: Int,
        displayH: Int,
        useAi: Boolean
    )
    private external fun nativeUpdateDimensions(width: Int, height: Int)
    private external fun nativeUnmountEngine()
}

