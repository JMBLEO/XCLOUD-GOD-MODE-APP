### 1.3 Motor 4: `AMediaCodec` + `ASurfaceControl` / `ASurfaceTransaction` (HWC2 Directo) + DPU AI Upscaling

**Por qué elegir este motor:**
En lugar de usar un contexto gráfico 3D (Vulkan u OpenGL), utiliza la API nativa de Android 10+ (`<android/surface_control.h>`) para crear un plano de hardware dedicado gobernado por transacciones atómicas del **Hardware Composer 2 (HWC2)**. Cada `AHardwareBuffer` emitido por `AMediaCodec` se adjunta a una `ASurfaceTransaction` con su valla de sincronización (`fence_fd`) y se delega al procesador de pantalla físico (DPU), activando simultáneamente los motores propietarios de **AI Video Super Resolution** del SoC (Snapdragon VPP / MediaTek MiraVision AI-SR / Exynos VT Upscaler).

```cpp
#include <media/NdkMediaCodec.h>
#include <media/NdkMediaFormat.h>
#include <media/NdkImageReader.h>
#include <android/surface_control.h>
#include <android/data_space.h>
#include <cstring>
#include <vector>

class Motor4HwcSurfaceTransaction : public IExtendedRenderNode {
    AMediaCodec* decoder = nullptr;
    AImageReader* imageReader = nullptr;
    ANativeWindow* decoderTargetWindow = nullptr;
    ASurfaceControl* videoPlaneControl = nullptr;
    int panelWidth = 1920;
    int panelHeight = 1080;
    bool aiEnabled = true;

    static void onFrameAvailable(void* context, AImageReader* reader) {
        auto* self = static_cast<Motor4HwcSurfaceTransaction*>(context);
        AImage* img = nullptr;
        int acquireFenceFd = -1;

        // Captura asíncrona con descriptor de valla de hardware (evita tearing)
        if (AImageReader_acquireLatestImageAsync(reader, &img, &acquireFenceFd) == AMEDIA_OK && img) {
            AHardwareBuffer* hwBuf = nullptr;
            if (AImage_getHardwareBuffer(img, &hwBuf) == AMEDIA_OK && hwBuf) {
                self->presentViaHwcTransaction(hwBuf, acquireFenceFd, img);
            } else {
                AImage_delete(img);
            }
        }
    }

    void presentViaHwcTransaction(AHardwareBuffer* hwBuf, int fenceFd, AImage* ownerImage) {
        if (!videoPlaneControl) {
            AImage_delete(ownerImage);
            return;
        }

        ASurfaceTransaction* tx = ASurfaceTransaction_create();
        
        // Definir geometría de escalado por hardware (de 1080p del stream a resolución nativa del panel)
        ARect srcRect = {0, 0, 1920, 1080};
        ARect dstRect = {0, 0, panelWidth, panelHeight};
        ASurfaceTransaction_setGeometry(tx, videoPlaneControl, srcRect, dstRect, ANATIVEWINDOW_TRANSFORM_IDENTITY);
        
        // Entregar el AHardwareBuffer y su fence_fd directo al DPU/HWC2
        ASurfaceTransaction_setBuffer(tx, videoPlaneControl, hwBuf, fenceFd);
        ASurfaceTransaction_setBufferDataSpace(tx, videoPlaneControl, ADATASPACE_BT709);

        // Liberar el AImage solo cuando el HWC2 confirme que el frame fue escaneado
        ASurfaceTransaction_setOnComplete(tx, ownerImage, [](void* ctx, ASurfaceTransactionStats*) {
            auto* releasedImg = static_cast<AImage*>(ctx);
            if (releasedImg) AImage_delete(releasedImg);
        });

        ASurfaceTransaction_apply(tx);
        ASurfaceTransaction_delete(tx);
    }

public:
    bool mount(ANativeWindow* hostWindow, int displayW, int displayH, bool enableAi) override {
        panelWidth = displayW;
        panelHeight = displayH;
        aiEnabled = enableAi;

        // Crear plano hijo en el Hardware Composer anclado a la ventana nativa
        videoPlaneControl = ASurfaceControl_createFromWindow(hostWindow, "GodMode_HWC2_StreamPlane");
        if (!videoPlaneControl) return false;

        ASurfaceTransaction* initTx = ASurfaceTransaction_create();
        ASurfaceTransaction_setVisibility(initTx, videoPlaneControl, ASURFACE_TRANSACTION_VISIBILITY_SHOW);
        ASurfaceTransaction_setZOrder(initTx, videoPlaneControl, 0);
        ASurfaceTransaction_apply(initTx);
        ASurfaceTransaction_delete(initTx);

        return true;
    }

    void configureCsd(const uint8_t* sps, size_t spsSize, const uint8_t* pps, size_t ppsSize, int streamW, int streamH) override {
        if (decoder) return;

        // Uso GPU_SAMPLED + COMPOSER_OVERLAY para permitir bypass directo al HWC2
        uint64_t usageFlags = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE | 0x800ULL; // COMPOSER_OVERLAY
        AImageReader_newWithUsage(streamW, streamH, AIMAGE_FORMAT_PRIVATE, usageFlags, 4, &imageReader);

        AImageReader_ImageListener listener = {this, onFrameAvailable};
        AImageReader_setImageListener(imageReader, &listener);
        AImageReader_getWindow(imageReader, &decoderTargetWindow);

        decoder = AMediaCodec_createDecoderByType("video/avc");
        AMediaFormat* fmt = AMediaFormat_new();
        AMediaFormat_setString(fmt, AMEDIAFORMAT_KEY_MIME, "video/avc");
        AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_WIDTH, streamW);
        AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_HEIGHT, streamH);
        AMediaFormat_setInt32(fmt, "low-latency", 1);
        AMediaFormat_setInt32(fmt, "priority", 0);

        // Inyectar CSD-0 (SPS) y CSD-1 (PPS)
        AMediaFormat_setBuffer(fmt, "csd-0", sps, spsSize);
        AMediaFormat_setBuffer(fmt, "csd-1", pps, ppsSize);

        // Activar AI Video Super Resolution en el procesador de video del SoC
        if (aiEnabled) {
            AMediaFormat_setInt32(fmt, "vendor.qti-ext-vpp.mode", 1);
            AMediaFormat_setInt32(fmt, "vendor.qti-ext-vpp-aisr.enable", 1);
            AMediaFormat_setInt32(fmt, "vendor.mtk-ext-ai-sr.enable", 1);
            AMediaFormat_setInt32(fmt, "vendor.sec-ext-vt-ai-upscale.enable", 1);
        }

        AMediaCodec_configure(decoder, fmt, decoderTargetWindow, nullptr, 0);
        AMediaCodec_start(decoder);
        AMediaFormat_delete(fmt);
    }

    void submitAccessUnit(const uint8_t* auData, size_t auSize, uint64_t ptsUs, bool isKeyframe) override {
        if (!decoder) return;

        ssize_t inIdx = AMediaCodec_dequeueInputBuffer(decoder, 1500);
        if (inIdx >= 0) {
            size_t cap = 0;
            uint8_t* dst = AMediaCodec_getInputBuffer(decoder, inIdx, &cap);
            if (dst && auSize <= cap) {
                std::memcpy(dst, auData, auSize);
                AMediaCodec_queueInputBuffer(decoder, inIdx, 0, auSize, ptsUs, isKeyframe ? 1 : 0);
            }
        }

        AMediaCodecBufferInfo info{};
        ssize_t outIdx = AMediaCodec_dequeueOutputBuffer(decoder, &info, 0);
        while (outIdx >= 0) {
            AMediaCodec_releaseOutputBuffer(decoder, outIdx, info.size > 0);
            outIdx = AMediaCodec_dequeueOutputBuffer(decoder, &info, 0);
        }
    }

    void updateDisplaySize(int width, int height) override {
        panelWidth = width;
        panelHeight = height;
    }

    void unmount() override {
        if (decoder) {
            AMediaCodec_stop(decoder);
            AMediaCodec_delete(decoder);
            decoder = nullptr;
        }
        if (imageReader) {
            AImageReader_delete(imageReader);
            imageReader = nullptr;
        }
        if (videoPlaneControl) {
            ASurfaceControl_release(videoPlaneControl);
            videoPlaneControl = nullptr;
        }
    }
};

std::unique_ptr<IExtendedRenderNode> buildMotor4HwcSurfaceTransaction() {
    return std::make_unique<Motor4HwcSurfaceTransaction>();
}

```

