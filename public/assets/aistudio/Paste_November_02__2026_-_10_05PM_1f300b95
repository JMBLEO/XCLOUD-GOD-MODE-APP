2. Orquestador JNI y Enrutador de Flujo RTP/Nano (C++20)
El puente JNI convierte el objeto android.view.Surface en un puntero ANativeWindow*. A través de una interfaz polimórfica de cero sobrecarga (IStreamEngine), el hilo receptor de sockets UDP (protocolo Nano o SRTP directo) inyecta las unidades NAL Annex-B ensambladas hacia cualquiera de los tres motores sin alterar la lógica de red.
#include <jni.h>
#include <android/native_window_jni.h>
#include <memory>
#include <cstdint>
#include <vector>

// Interfaz base estricta para los 3 motores de decodificación y renderizado
class IStreamEngine {
public:
    virtual ~IStreamEngine() = default;
    virtual bool initialize(ANativeWindow* window, int streamWidth, int streamHeight, bool aiUpscale) = 0;
    virtual void injectCodecConfig(const uint8_t* sps, size_t spsLen, const uint8_t* pps, size_t ppsLen) = 0;
    virtual void pushAnnexBNalUnit(const uint8_t* data, size_t size, uint64_t ptsUs, bool isIdr) = 0;
    virtual void onResize(int displayWidth, int displayHeight) = 0;
    virtual void shutdown() = 0;
};

// Declaraciones anticipadas de los 3 motores
std::unique_ptr<IStreamEngine> createEngine1RustSecureVulkan();
std::unique_ptr<IStreamEngine> createEngine2VulkanVideoAsic();
std::unique_ptr<IStreamEngine> createEngine3MediaCodecAiNpu();

namespace {
    ANativeWindow* g_nativeWindow = nullptr;
    std::unique_ptr<IStreamEngine> g_activeEngine = nullptr;
}

extern "C" JNIEXPORT void JNICALL
Java_com_godmode_xcloud_stream_BareStreamActivity_nativeInitStreamPipeline(
        JNIEnv* env, jobject /*thiz*/, jobject surface, jint engineType, 
        jint width, jint height, jboolean enableAiUpscale) {

    if (g_activeEngine) {
        g_activeEngine->shutdown();
        g_activeEngine.reset();
    }
    if (g_nativeWindow) {
        ANativeWindow_release(g_nativeWindow);
    }

    g_nativeWindow = ANativeWindow_fromSurface(env, surface);

    switch (engineType) {
        case 1:
            g_activeEngine = createEngine1RustSecureVulkan();
            break;
        case 2:
            g_activeEngine = createEngine2VulkanVideoAsic();
            break;
        case 3:
        default:
            g_activeEngine = createEngine3MediaCodecAiNpu();
            break;
    }

    if (g_activeEngine && g_nativeWindow) {
        g_activeEngine->initialize(g_nativeWindow, width, height, static_cast<bool>(enableAiUpscale));
    }
}

extern "C" JNIEXPORT void JNICALL
Java_com_godmode_xcloud_stream_BareStreamActivity_nativeOnSurfaceResized(
        JNIEnv* /*env*/, jobject /*thiz*/, jint width, jint height) {
    if (g_activeEngine) {
        g_activeEngine->onResize(width, height);
    }
}

extern "C" JNIEXPORT void JNICALL
Java_com_godmode_xcloud_stream_BareStreamActivity_nativeShutdownStreamPipeline(
        JNIEnv* /*env*/, jobject /*thiz*/) {
    if (g_activeEngine) {
        g_activeEngine->shutdown();
        g_activeEngine.reset();
    }
    if (g_nativeWindow) {
        ANativeWindow_release(g_nativeWindow);
        g_nativeWindow = nullptr;
    }
}

// Punto de entrada llamado desde el hilo de red UDP/SRTP en Rust o C++
extern "C" void godmode_dispatch_nal_unit(const uint8_t* annexBData, size_t size, uint64_t ptsUs, bool isIdr) {
    if (g_activeEngine) {
        g_activeEngine->pushAnnexBNalUnit(annexBData, size, ptsUs, isIdr);
    }
}


3. Proceso de Inyección de los 3 Motores Nativos
Motor 1: Decodificador Memory-Safe en Rust (OpenH264 / rav1d) + Subida Directa a Vulkan
Este motor procesa el bitstream en un entorno aislado en Rust que valida matemáticamente la estructura de la NAL antes de decodificarla, evitando cualquier vulnerabilidad de corrupción de memoria heredada. Una vez obtenidos los planos Y, U y V, los transfiere mediante un Staging Buffer mapeado persistentemente hacia la textura Vulkan o pasa por el pipeline de AI Upscaling antes de presentar en el VkSwapchainKHR.
// Lado Rust exportado vía FFI hacia Engine 1 C++ Wrapper
use openh264::decoder::{Decoder, DecoderConfig};
use std::slice;

pub struct RustZeroTrustEngine {
    decoder: Decoder,
    frame_width: usize,
    frame_height: usize,
}

#[repr(C)]
pub struct DecodedYuvPlanes {
    pub y_ptr: *const u8,
    pub u_ptr: *const u8,
    pub v_ptr: *const u8,
    pub y_stride: i32,
    pub u_stride: i32,
    pub v_stride: i32,
    pub width: i32,
    pub height: i32,
}

#[no_mangle]
pub extern "C" fn rust_engine1_create() -> *mut RustZeroTrustEngine {
    let config = DecoderConfig::new();
    if let Ok(decoder) = Decoder::with_config(config) {
        Box::into_raw(Box::new(RustZeroTrustEngine {
            decoder,
            frame_width: 1920,
            frame_height: 1080,
        }))
    } else {
        std::ptr::null_mut()
    }
}

#[no_mangle]
pub unsafe extern "C" fn rust_engine1_decode_nal(
    engine: *mut RustZeroTrustEngine,
    nal_ptr: *const u8,
    nal_len: usize,
    out_planes: *mut DecodedYuvPlanes,
) -> bool {
    if engine.is_null() || nal_ptr.is_null() || nal_len < 5 || nal_len > 2_097_152 {
        return false;
    }

    let eng = &mut *engine;
    let packet = slice::from_raw_parts(nal_ptr, nal_len);

    // Verificación estricta de prefijo Annex-B (0x00 0x00 0x00 0x01)
    if &packet[0..4] != &[0, 0, 0, 1] {
        return false;
    }

    // Filtrar exclusivamente unidades NAL válidas de streaming (Non-IDR=1, IDR=5, SEI=6, SPS=7, PPS=8)
    let nal_type = packet[4] & 0x1F;
    if !matches!(nal_type, 1 | 5 | 6 | 7 | 8) {
        return false;
    }

    if let Ok(Some(yuv)) = eng.decoder.decode(packet) {
        let (w, h) = yuv.dimension_rgb();
        let (y_stride, u_stride, v_stride) = yuv.strides_yuv();
        
        (*out_planes) = DecodedYuvPlanes {
            y_ptr: yuv.y_with_stride().as_ptr(),
            u_ptr: yuv.u_with_stride().as_ptr(),
            v_ptr: yuv.v_with_stride().as_ptr(),
            y_stride: y_stride as i32,
            u_stride: u_stride as i32,
            v_stride: v_stride as i32,
            width: w as i32,
            height: h as i32,
        };
        return true;
    }
    false
}


// Envoltorio C++ de Motor 1: Recibe los planos validados de Rust y los presenta en Vulkan
