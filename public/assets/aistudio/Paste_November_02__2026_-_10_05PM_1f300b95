Alternativa 2: Stack Nano Protocol (URCP / RtspOverUdp) + AMediaCodec Async Callback
Basado en OpenXbox/xcloud-rs/gamestreaming_native y OpenXbox/xcloud-tools. Cuando solicitas la sesión o conectas por xHome/xCloud nativo usando el proveedor {3f3c85cb-a328-4467-96df-438d76b4ac59} Microsoft.Streaming.Nano.Network, el flujo viaja sobre paquetes UDP con cabecera Nano FrameData. El fallo clásico al inyectar Nano en AMediaCodec es usar llamadas bloqueantes (dequeueInputBuffer). La solución infalible es configurar AMediaCodec_setAsyncNotifyCallback e inyectar el paquete de configuración CSD-0 (SPS/PPS combinados con prefijo 0x00000001) con el flag AMEDIACODEC_BUFFER_FLAG_CODEC_CONFIG.
// Alternativa 2: Nano Protocol Directo -> AMediaCodec Async Mode (Zero-Copy Hardware)
#include <media/NdkMediaCodec.h>
#include <android/native_window.h>
#include <queue>
#include <mutex>

class NanoNativeAsyncRenderer {
    AMediaCodec* codec = nullptr;
    std::queue<int32_t> availableInputBuffers;
    std::mutex mtx;

    static void onAsyncInputAvailable(AMediaCodec*, void* userdata, int32_t index) {
        auto* self = static_cast<NanoNativeAsyncRenderer*>(userdata);
        std::lock_guard<std::mutex> lock(self->mtx);
        self->availableInputBuffers.push(index);
    }

    static void onAsyncOutputAvailable(AMediaCodec* c, void*, int32_t index, AMediaCodecBufferInfo* info) {
        // Liberar y renderizar directamente en el Surface (Hardware Overlay) en cuanto sale del chip
        AMediaCodec_releaseOutputBuffer(c, index, info->size > 0);
    }

    static void onAsyncFormatChanged(AMediaCodec*, void*, AMediaFormat*) {}
    static void onAsyncError(AMediaCodec*, void*, media_status_t, int32_t, const char*) {}

public:
    void startNanoHardwarePipeline(ANativeWindow* surface, const uint8_t* sps, size_t spsLen, const uint8_t* pps, size_t ppsLen) {
        codec = AMediaCodec_createDecoderByType("video/avc");
        AMediaFormat* fmt = AMediaFormat_new();
        AMediaFormat_setString(fmt, AMEDIAFORMAT_KEY_MIME, "video/avc");
        AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_WIDTH, 1920);
        AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_HEIGHT, 1080);
        AMediaFormat_setInt32(fmt, "low-latency", 1);

        // CRÍTICO: Inyectar SPS (CSD-0) y PPS (CSD-1) extraídos del paquete Nano StreamControl
        AMediaFormat_setBuffer(fmt, "csd-0", sps, spsLen);
        AMediaFormat_setBuffer(fmt, "csd-1", pps, ppsLen);

        AMediaCodecOnAsyncNotifyCallback callbacks = {
            onAsyncInputAvailable, onAsyncOutputAvailable, onAsyncFormatChanged, onAsyncError
        };
        AMediaCodec_setAsyncNotifyCallback(codec, callbacks, this);
        AMediaCodec_configure(codec, fmt, surface, nullptr, 0);
        AMediaCodec_start(codec);
        AMediaFormat_delete(fmt);
    }

    void injectNanoVideoFrame(const uint8_t* annexBData, size_t size, uint64_t timestampUs, bool isKeyFrame) {
        int32_t bufIdx = -1;
        {
            std::lock_guard<std::mutex> lock(mtx);
            if (availableInputBuffers.empty()) return;
            bufIdx = availableInputBuffers.front();
            availableInputBuffers.pop();
        }

        size_t bufCapacity = 0;
        uint8_t* bufPtr = AMediaCodec_getInputBuffer(codec, bufIdx, &bufCapacity);
        if (bufPtr && size <= bufCapacity) {
            memcpy(bufPtr, annexBData, size);
            uint32_t flags = isKeyFrame ? 1 : 0; // 1 = BUFFER_FLAG_KEY_FRAME
            AMediaCodec_queueInputBuffer(codec, bufIdx, 0, size, timestampUs, flags);
        }
    }
};


Alternativa 3: Stack GStreamer Native (appsrc -> rtph264depay -> amcviddec -> glimagesink)
Basado directamente en el cliente client_gstreamer de OpenXbox/xcloud-rs. Si en algún SoC Android el desempaquetado manual o los timestamps RTP causan micro-cortes, GStreamer para Android (o Rust gstreamer-rs) cuenta con un desensamblador RFC 6184 industrial (rtph264depay), un parseador de NALs (h264parse) que inserta automáticamente los SPS/PPS en cada IDR frame (config-interval=-1), y el puente directo al hardware de Android (amcviddec -> glimagesink).
// Alternativa 3: Basado en OpenXbox/xcloud-rs/client_gstreamer (Rust)
use gstreamer as gst;
use gstreamer::prelude::*;
use gstreamer_app as gst_app;

pub struct GStreamerNativeEngine {
    pipeline: gst::Pipeline,
    appsrc: gst_app::AppSrc,
}

impl GStreamerNativeEngine {
    pub fn new() -> Result<Self, Box<dyn std::error::Error>> {
        gst::init()?;

        // Pipeline idéntico a client_gstreamer optimizado para Android Hardware Decoding (amcviddec)
        // config-interval=-1 fuerza la reinyección de SPS/PPS para evitar pantalla negra en pérdida de paquetes
        let pipeline_str = concat!(
            "appsrc name=xcloud_src is-live=true format=time do-timestamp=true ",
            "caps=\"application/x-rtp,media=(string)video,clock-rate=(int)90000,encoding-name=(string)H264,payload=(int)96\" ! ",
            "rtpjitterbuffer latency=10 drop-on-latency=true ! ",
            "rtph264depay ! ",
            "h264parse config-interval=-1 ! ",
            "decodebin ! ",
            "glimagesink sync=false"
        );

        let element = gst::parse::launch(pipeline_str)?;
        let pipeline = element.dynamic_cast::<gst::Pipeline>().unwrap();
        let appsrc = pipeline
            .by_name("xcloud_src")
            .unwrap()
            .dynamic_cast::<gst_app::AppSrc>()
            .unwrap();

        pipeline.set_state(gst::State::Playing)?;

        Ok(Self { pipeline, appsrc })
    }

    /// Recibe el paquete RTP descifrado por SRTP y lo empuja directo al pipeline nativo
    pub fn push_decrypted_rtp_packet(&self, rtp_bytes: &[u8]) {
        let mut buffer = gst::Buffer::with_size(rtp_bytes.len()).unwrap();
        {
            let buffer_ref = buffer.get_mut().unwrap();
            let mut map = buffer_ref.map_writable().unwrap();
            map.copy_from_slice(rtp_bytes);
        }
        let _ = self.appsrc.push_buffer(buffer);
    }
}


Cómo Conectar los 3 Motores en tu Botón de Conmutación del HUD:
Elimina por completo el WebView de tu layout de Android.
En el selector del modal de error (o en el menú superior del HUD), vincula el botón a un enum RenderBackend { VULKAN_CUSTOM, SDL3_FFMPEG_LIBDATACHANNEL, NANO_AMEDIACODEC_ASYNC, GSTREAMER_NATIVE }.
Pasa siempre el flujo RTP entrante por RtpH264Depacketizer (o rtph264depay!h264parse en el Motor 3) y envía una trama RTCP PLI (Picture Loss Indication) inmediatamente después de abrir el canal UDP para obligar al blade de Xbox Series X en Azure a escupir un fotograma IDR + SPS + PPS en el milisegundo 0.


Para blindar el motor God Mode bajo un estándar de Cero Confianza (Zero-Trust) y Seguridad de Memoria, podemos erradicar FFmpeg por completo de la Alternativa 1 y reemplazarlo por tres opciones de decodificación blindadas, minimalistas y verificadas que operan directamente con el flujo SRTP/Nano:
