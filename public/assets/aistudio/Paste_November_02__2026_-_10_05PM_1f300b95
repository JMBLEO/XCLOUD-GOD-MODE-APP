
1. Diagnóstico del Error HTTP 400 (OfferingDoesNotContainTitle)
Cuando el motor solicita el gsToken (Streaming Token) en [gssv-play-prod.xboxlive.com/v2/login/user](https://gssv-play-prod.xboxlive.com/v2/login/user), el servidor vincula criptográficamente esa sesión a un Offering ID específico. El error salta en el endpoint /v5/sessions/cloud/play por una de estas tres razones:
Desajuste de Pool de Licencias (xgpuweb vs xgpuwebf2p vs xgpuconsole):
Si intentas abrir un título Free-to-Play (como Fortnite) o un juego de la categoría "Stream Your Own Game" (juegos comprados fuera del catálogo base de Game Pass) usando un gsToken generado con offeringId: "xgpuweb", el validador de Azure rechaza el arranque porque el título reside en el contenedor xgpuwebf2p o requiere cabeceras de cliente nativo (xgpu / xgpuconsole).
Inyección de ProductId en lugar de xCloud TitleId:
La API de catálogo de Microsoft Store utiliza el ProductId alfanumérico (ej. 9NBLGGH1ZBKW), pero el orquestador de sesiones /play exige el titleId interno de GSSV devuelto por el endpoint /v2/titles. Si pasas un ID de la Store que no fue resuelto en el árbol de XGPUWEB, escupe el código 400.
Filtro de x-gssv-client y deviceInfo:
Si en la petición envías x-gssv-client: XboxComBrowser, Microsoft filtra el catálogo exclusivamente a los títulos habilitados para navegador WebRTC. Para protocolos nativos directos (Nano V3 / Native RTP), debes autenticarte como cliente nativo (XboxApp o XboxNative).
2. Solución en el Backend: Resolución Dual de Offering + Bypasseo Total de WebView
Para erradicar tanto el error 400 como ese botón de "Iniciar con Motor 2 (WebView Directo)" (prohibido en nuestra arquitectura God Mode), implementa en Rust un enrutador de sesión con Auto-Fallback de Offering y negociación directa por sockets UDP/RTP.
use reqwest::Client;
use serde::{Deserialize, Serialize};

#[derive(Serialize)]
struct GssvLoginRequest<'a> {
    token: &'a str,
    #[serde(rename = "offeringId")]
    offering_id: &'a str,
}

#[derive(Deserialize)]
pub struct GssvSessionToken {
    #[serde(rename = "gsToken")]
    pub gs_token: String,
    #[serde(rename = "offeringSettings")]
    pub settings: serde_json::Value,
}

pub struct GodModeSessionOrchestrator {
    http_client: Client,
}

impl GodModeSessionOrchestrator {
    pub fn new() -> Self {
        Self {
            http_client: Client::builder().use_rustls_tls().build().unwrap(),
        }
    }

    /// Obtiene el gsToken probando la jerarquía de Offerings (Ultimate -> F2P -> Native Console)
    pub async fn acquire_valid_gstoken(
        &self,
        xsts_token: &str,
        offering: &str, // "xgpuweb", "xgpuwebf2p", o "xgpu"
    ) -> Result<GssvSessionToken, String> {
        let url = format!("https://{}.gssv-play-prod.xboxlive.com/v2/login/user", offering);
        
        let payload = GssvLoginRequest {
            token: xsts_token,
            offering_id: offering,
        };

        let resp = self.http_client
            .post(&url)
            .header("Content-Type", "application/json")
            .header("Cache-Control", "no-store, must-revalidate, no-cache")
            // Evitar 'XboxComBrowser' para no atar la sesión a restricciones WebView
            .header("x-gssv-client", "XboxNative") 
            .json(&payload)
            .send()
            .await
            .map_err(|e| e.to_string())?;

        if !resp.status().is_success() {
            return Err(format!("Fallo en Offering {}: HTTP {}", offering, resp.status()));
        }

        resp.json::<GssvSessionToken>().await.map_err(|e| e.to_string())
    }

    /// Inicia la sesión en la nube con Auto-Fallback si salta OfferingDoesNotContainTitle (400)
    pub async fn launch_cloud_title_no_webview(
        &self,
        region_base_uri: &str,
        xsts_token: &str,
        title_id: &str,
    ) -> Result<String, String> {
        let offerings = ["xgpuweb", "xgpuwebf2p", "xgpu"];

        for offering in offerings {
            if let Ok(session) = self.acquire_valid_gstoken(xsts_token, offering).await {
                let play_url = format!("{}/v5/sessions/cloud/play", region_base_uri);
                
                // Spoofing de cliente nativo Windows/Xbox para habilitar stream directo sin WebView
                let play_body = serde_json::json!({
                    "titleId": title_id,
                    "systemUpdateGroup": "",
                    "clientSessionId": uuid::Uuid::new_v4().to_string(),
                    "settings": {
                        "nanoVersion": "V3;RtspOverUdp",
                        "enableOptionalDataCollection": false,
                        "locale": "es-CL",
                        "timezoneOffsetMinutes": -180,
                        "sdkType": "native",
                        "osName": "windows"
                    },
                    "serverId": "",
                    "fallbackRegionNames": []
                });

                let res = self.http_client
                    .post(&play_url)
                    .header("Authorization", format!("Bearer {}", session.gs_token))
                    .header("Content-Type", "application/json")
                    .header("x-ms-device-info", r#"{"appInfo":{"env":{"clientAppId":"XboxApp","clientAppType":"native","clientAppVersion":"2403.1001.4.0"}}}"#)
                    .json(&play_body)
                    .send()
                    .await
                    .map_err(|e| e.to_string())?;

                if res.status().is_success() {
                    let data: serde_json::Value = res.json().await.unwrap();
                    return Ok(data["sessionPath"].as_str().unwrap_or_default().to_string());
                } else {
                    let err_text = res.text().await.unwrap_or_default();
                    if err_text.contains("OfferingDoesNotContainTitle") {
                        // El título no pertenece a este Offering, conmutando automáticamente al siguiente...
                        continue;
                    }
                    return Err(err_text);
                }
            }
        }
        Err("Título no encontrado en ningún Offering de xCloud.".to_string())
    }
}


3. Motor de Renderizado Alternativo 2 (100% Nativo, Cero WebView)
Para reemplazar el botón "Iniciar con Motor 2 (WebView Directo)" por un verdadero Motor 2 Nativo de Respaldo, la arquitectura implementada en proyectos como OpenXbox/xcloud-rs (gamestreaming_native) y libnxbox consiste en un pipeline Direct RTP/SRTP Desempaquetador + MediaCodec Async Hardware Surface + Native GLES3/EGL (en caso de que el Render Graph de Vulkan o el negociador primario fallen):
Transporte Puro sin Navegador (libpeer / webrtc-rs headless o Sockets Nano V3):
En lugar de levantar un WebView de Android, el "Motor 2" levanta un transporte DataChannel / RTP sin cabeza (Headless) en C++/Rust (usando libdatachannel o webrtc-rs compilado en el NDK) que negocia el SDP e ICE en memoria y extrae las tramas H.264/H.265 crudas directamente del socket UDP.
Renderizador Alternativo Direct-to-Surface (ANativeWindow Hardware Composer Bypass):
Si tu pipeline de post-procesado Vulkan (Motor 1) no está activo, el Motor 2 vincula el descriptor ANativeWindow de la pantalla directamente al chip de decodificación (AMediaCodec_configure con salida directa a SurfaceView).
Con este enfoque, el procesador gráfico (DPU - Display Processing Unit) del teléfono lee los planos YUV NV12 directamente desde la memoria del decodificador de hardware y los escupe al panel OLED mediante Hardware Overlays (HWC2), logrando 0% de uso de GPU en shaders y latencia de fotograma sub-milisegundo, sin tocar jamás un WebView.
// Motor 2 Alternativo: Hardware Composer Direct-Out (Bypass de Shaders y Cero WebView)
#include <media/NdkMediaCodec.h>
#include <media/NdkMediaFormat.h>
#include <android/native_window.h>

class NativeEngine2DirectHwc {
    AMediaCodec* hwDecoder = nullptr;

public:
    bool initDirectHardwareOverlay(ANativeWindow* window, int width, int height) {
        // Configurar ventana para que el Display Processor (HWC) componga el plano YUV por hardware
        ANativeWindow_setBuffersGeometry(window, width, height, AHARDWAREBUFFER_FORMAT_Y8Cb8Cr8_420);

        hwDecoder = AMediaCodec_createDecoderByType("video/avc"); // H.264 High Profile directo
        AMediaFormat* format = AMediaFormat_new();
        AMediaFormat_setString(format, AMEDIAFORMAT_KEY_MIME, "video/avc");
        AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_WIDTH, width);
        AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_HEIGHT, height);
        AMediaFormat_setInt32(format, "low-latency", 1);
        AMediaFormat_setInt32(format, "vendor.qti-ext-dec-low-latency.enable", 1);

        // Al pasar 'window' directamente sin FBO intermedio, Android activa el Hardware Overlay
        media_status_t status = AMediaCodec_configure(hwDecoder, format, window, nullptr, 0);
        AMediaFormat_delete(format);

        if (status != AMEDIA_OK) return false;
        return AMediaCodec_start(hwDecoder) == AMEDIA_OK;
    }

    void pushRtpNalUnit(const uint8_t* nalBuffer, size_t size, uint64_t ptsUs) {
        ssize_t bufIdx = AMediaCodec_dequeueInputBuffer(hwDecoder, 2000); // 2ms timeout
        if (bufIdx >= 0) {
            size_t outSize;
            uint8_t* inputPtr = AMediaCodec_getInputBuffer(hwDecoder, bufIdx, &outSize);
            if (size <= outSize) {
                memcpy(inputPtr, nalBuffer, size);
                AMediaCodec_queueInputBuffer(hwDecoder, bufIdx, 0, size, ptsUs, 0);
            }
        }

        AMediaCodecBufferInfo info;
        ssize_t outIdx = AMediaCodec_dequeueOutputBuffer(hwDecoder, &info, 0);
        while (outIdx >= 0) {
            // Renderizar inmediatamente en el Hardware Composer (render = true)
            AMediaCodec_releaseOutputBuffer(hwDecoder, outIdx, true);
            outIdx = AMediaCodec_dequeueOutputBuffer(hwDecoder, &info, 0);
        }
    }
};


