        DecodedYuvPlanes planes{};
        if (rust_engine1_decode_nal(rustDecoderCtx, data, size, &planes)) {
            // Sube planos Y, U, V al Staging Buffer de Vulkan
            // Si useAiUpscale == true, ejecuta el Compute Shader de Super-Resolución antes de vkQueuePresentKHR
        }
    }

    void onResize(int /*displayWidth*/, int /*displayHeight*/) override {}
    void shutdown() override {}
};

std::unique_ptr<IStreamEngine> createEngine1RustSecureVulkan() {
    return std::make_unique<Engine1RustSecureVulkan>();
