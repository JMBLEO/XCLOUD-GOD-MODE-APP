### 3. Proceso de Inyección de los 3 Motores Nativos

#### Motor 1: Decodificador Memory-Safe en Rust (`OpenH264` / `rav1d`) + Subida Directa a Vulkan

Este motor procesa el bitstream en un entorno aislado en Rust que valida matemáticamente la estructura de la NAL antes de decodificarla, evitando cualquier vulnerabilidad de corrupción de memoria heredada. Una vez obtenidos los planos `Y`, `U` y `V`, los transfiere mediante un *Staging Buffer* mapeado persistentemente hacia la textura Vulkan o pasa por el pipeline de AI Upscaling antes de presentar en el `VkSwapchainKHR`.

```rust
// Lado Rust exportado vía FFI hacia Engine 1 C++ Wrapper
use openh264::decoder::{Decoder, DecoderConfig};
use std::slice;

pub struct RustZeroTrustEngine {
    decoder: Decoder,
    frame_width: usize,
    frame_height: usize,
}

#[repr(C)]
pub struct DecodedYuvPlanes {
    pub y_ptr: *const u8,
    pub u_ptr: *const u8,
    pub v_ptr: *const u8,
    pub y_stride: i32,
    pub u_stride: i32,
    pub v_stride: i32,
    pub width: i32,
    pub height: i32,
}

#[no_mangle]
pub extern "C" fn rust_engine1_create() -> *mut RustZeroTrustEngine {
    let config = DecoderConfig::new();
    if let Ok(decoder) = Decoder::with_config(config) {
        Box::into_raw(Box::new(RustZeroTrustEngine {
            decoder,
            frame_width: 1920,
            frame_height: 1080,
        }))
    } else {
        std::ptr::null_mut()
    }
}

#[no_mangle]
pub unsafe extern "C" fn rust_engine1_decode_nal(
    engine: *mut RustZeroTrustEngine,
    nal_ptr: *const u8,
    nal_len: usize,
    out_planes: *mut DecodedYuvPlanes,
) -> bool {
    if engine.is_null() || nal_ptr.is_null() || nal_len < 5 || nal_len > 2_097_152 {
        return false;
    }

    let eng = &mut *engine;
    let packet = slice::from_raw_parts(nal_ptr, nal_len);

    // Verificación estricta de prefijo Annex-B (0x00 0x00 0x00 0x01)
    if &packet[0..4] != &[0, 0, 0, 1] {
        return false;
    }

    // Filtrar exclusivamente unidades NAL válidas de streaming (Non-IDR=1, IDR=5, SEI=6, SPS=7, PPS=8)
    let nal_type = packet[4] & 0x1F;
    if !matches!(nal_type, 1 | 5 | 6 | 7 | 8) {
        return false;
    }

    if let Ok(Some(yuv)) = eng.decoder.decode(packet) {
        let (w, h) = yuv.dimension_rgb();
        let (y_stride, u_stride, v_stride) = yuv.strides_yuv();
        
        (*out_planes) = DecodedYuvPlanes {
            y_ptr: yuv.y_with_stride().as_ptr(),
            u_ptr: yuv.u_with_stride().as_ptr(),
            v_ptr: yuv.v_with_stride().as_ptr(),
            y_stride: y_stride as i32,
            u_stride: u_stride as i32,
            v_stride: v_stride as i32,
            width: w as i32,
            height: h as i32,
        };
        return true;
    }
    false
}

```

```cpp
