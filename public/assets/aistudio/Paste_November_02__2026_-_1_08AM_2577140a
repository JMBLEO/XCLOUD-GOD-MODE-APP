La arquitectura de inyección unificada para los tres motores nativos elimina por completo el uso de `WebView` y desacopla los elementos de telemetría, submenús y controles en pantalla. El diseño se basa en un lienzo limpio (`SurfaceView` a pantalla completa en estado 0) que entrega un puntero `ANativeWindow*` directamente al código nativo mediante JNI. Sobre este descriptor nativo operan el despachador de motores y el módulo de reescalado por inteligencia artificial (AI Upscaling).

---

### 1. Capa de Superficie Limpia en Android (Estado 0: Solo Stream)

Esta capa en Kotlin define únicamente un `SurfaceView` desprovisto de interfaz gráfica adicional, botones virtuales o indicadores de red. Su única responsabilidad es capturar el ciclo de vida de la superficie física de la pantalla y transferir el control al orquestador en C++/Rust.

```kotlin
package com.godmode.xcloud.stream

import android.app.Activity
import android.os.Bundle
import android.view.Surface
import android.view.SurfaceHolder
import android.view.SurfaceView
import android.view.WindowManager
import androidx.core.view.WindowCompat
import androidx.core.view.WindowInsetsCompat
import androidx.core.view.WindowInsetsControllerCompat

enum class StreamEngineType(val id: Int) {
    ENGINE_1_RUST_SECURE_VULKAN(1), // Rust Zero-Trust + OpenH264/rav1d + Vulkan
    ENGINE_2_VULKAN_VIDEO_ASIC(2),  // Vulkan Video Hardware Direct (VK_KHR_video_decode_queue)
    ENGINE_3_MEDIACODEC_AI_NPU(3)   // AMediaCodec Async + HardwareBuffer + AI Upscaling
}

classBareStreamActivity : Activity(), SurfaceHolder.Callback {

    companion object {
        init {
            System.loadLibrary("godmode_stream_core")
        }
    }

    private lateinit var surfaceView: SurfaceView
    private var activeEngine: StreamEngineType = StreamEngineType.ENGINE_3_MEDIACODEC_AI_NPU
    private var enableAiUpscaling: Boolean = true

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        // Configurar pantalla completa absoluta sin barras de sistema ni recortes
        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
        WindowCompat.setDecorFitsSystemWindows(window, false)
        WindowInsetsControllerCompat(window, window.decorView).let { controller ->
            controller.hide(WindowInsetsCompat.Type.systemBars())
            controller.systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
        }

        // Selección de motor desde el Intent o conmutador previo al arranque
        val engineId = intent.getIntExtra("ENGINE_ID", StreamEngineType.ENGINE_3_MEDIACODEC_AI_NPU.id)
        activeEngine = StreamEngineType.values().firstOrNull { it.id == engineId } 
            ?: StreamEngineType.ENGINE_3_MEDIACODEC_AI_NPU
        enableAiUpscaling = intent.getBooleanExtra("AI_UPSCALING", true)

        // Instanciar únicamente el lienzo limpio en 0 (sin OSD, sin HUD, sin botones)
        surfaceView = SurfaceView(this)
        surfaceView.holder.addCallback(this)
        setContentView(surfaceView)
    }

    override fun surfaceCreated(holder: SurfaceHolder) {
        // Inyectar la superficie nativa directamente al orquestador en C++/Rust
        nativeInitStreamPipeline(
            surface = holder.surface,
            engineType = activeEngine.id,
            width = 1920,
            height = 1080,
            enableAiUpscale = enableAiUpscaling
        )
    }

    override fun surfaceChanged(holder: SurfaceHolder, format: Int, width: Int, height: Int) {
        nativeOnSurfaceResized(width, height)
    }

    override fun surfaceDestroyed(holder: SurfaceHolder) {
        nativeShutdownStreamPipeline()
    }

    // Puentes JNI directos sin sobrecarga de objetos complejos
    private external fun nativeInitStreamPipeline(
        surface: Surface,
        engineType: Int,
        width: Int,
        height: Int,
        enableAiUpscale: Boolean
    )
    private external fun nativeOnSurfaceResized(width: Int, height: Int)
    private external fun nativeShutdownStreamPipeline()
}

