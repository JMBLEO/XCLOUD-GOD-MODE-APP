extern "C" {

JNIEXPORT void JNICALL
Java_com_xcloud_godmode_core_GodModeNativeBridge_initOboeProceduralAudio(JNIEnv *, jobject) {
    oboe::AudioStreamBuilder builder;
    builder.setDirection(oboe::Direction::Output)
        ->setPerformanceMode(oboe::PerformanceMode::LowLatency)
        ->setSharingMode(oboe::SharingMode::Exclusive)
        ->setFormat(oboe::AudioFormat::Float)
        ->setChannelCount(oboe::ChannelCount::Stereo)
        ->setSampleRate(48000)
        ->setDataCallback(&gUiSynth);
    builder.openStream(gOboeStream);
    if (gOboeStream) gOboeStream->requestStart();
}

JNIEXPORT void JNICALL
Java_com_xcloud_godmode_core_GodModeNativeBridge_playProceduralUiSfx(
    JNIEnv *, jobject, jint sfxType
) {
    switch (sfxType) {
        case 0: gUiSynth.triggerTone(520.0f, 0.18f); break;
        case 1: gUiSynth.triggerTone(880.0f, 0.32f); break;
        case 2: gUiSynth.triggerTone(310.0f, 0.22f); break;
    }
}

JNIEXPORT jstring JNICALL
Java_com_xcloud_godmode_core_GodModeNativeBridge_buildControlChannelLeverJson(
    JNIEnv *env, jobject, jstring resolutionAliasJ, jint targetBitrateMbps
) {
    const char *aliasC = env->GetStringUTFChars(resolutionAliasJ, nullptr);
    std::string alias(aliasC);
    env->ReleaseStringUTFChars(resolutionAliasJ, aliasC);

    long long bps = static_cast<long long>(targetBitrateMbps) * 1000000LL;
    std::string payload = "{\"resolutionCommand\":{\"message\":\"userRequestedResolutionUpdate\",\"resolutionAlias\":\"" +
                          alias + "\"},\"bitrateCommand\":{\"message\":\"rateControlBitrateUpdate\",\"bitratebps\":" +
                          std::to_string(bps) + "}}";
    return env->NewStringUTF(payload.c_str());
}

