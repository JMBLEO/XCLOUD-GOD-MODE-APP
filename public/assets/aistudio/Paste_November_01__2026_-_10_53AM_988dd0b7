// 2. JOSECRIPTO: FIRMA ECDSA P-256 (IEEE P1363 64-BYTE + WINDOWS FILETIME)
// ============================================================================

object JoseCripto {
    private val keyPair: KeyPair by lazy {
        val kpg = KeyPairGenerator.getInstance("EC")
        kpg.initialize(ECGenParameterSpec("secp256r1"))
        kpg.generateKeyPair()
    }

    fun getProofKeyJwk(): JSONObject {
        val pub = keyPair.public as ECPublicKey
        val xBytes = toUnsigned32Bytes(pub.w.affineX.toByteArray())
        val yBytes = toUnsigned32Bytes(pub.w.affineY.toByteArray())
        val encoder = Base64.getUrlEncoder().withoutPadding()
        return JSONObject().apply {
            put("use", "sig")
            put("alg", "ES256")
            put("kty", "EC")
            put("crv", "P-256")
            put("x", encoder.encodeToString(xBytes))
            put("y", encoder.encodeToString(yBytes))
        }
    }

    /**
     * Genera el encabezado 'Signature' de 76 bytes exactos (4 policy + 8 Windows FileTime + 64 IEEE P1363)
     * requerido por device.auth.xboxlive.com y sisu.xboxlive.com.
     */
    fun signXboxRequest(url: String, authHeader: String = "", bodyJson: String): String {
        val parsed = url.toHttpUrl()
        val pathAndQuery = parsed.encodedPath + (if (parsed.encodedQuery != null) "?${parsed.encodedQuery}" else "")
        val windowsTimestamp = ((System.currentTimeMillis() / 1000L) + 11644473600L) * 10000000L

        val methodBytes = "POST".toByteArray(Charsets.UTF_8)
        val pathBytes = pathAndQuery.toByteArray(Charsets.UTF_8)
        val authBytes = authHeader.toByteArray(Charsets.UTF_8)
        val bodyBytes = bodyJson.toByteArray(Charsets.UTF_8)

        val totalSize = 4 + 1 + 8 + 1 + methodBytes.size + 1 + pathBytes.size + 1 + authBytes.size + 1 + bodyBytes.size + 1
        val buf = ByteBuffer.allocate(totalSize)
        buf.putInt(1)
        buf.put(0)
        buf.putLong(windowsTimestamp)
        buf.put(0)
        buf.put(methodBytes).put(0)
        buf.put(pathBytes).put(0)
        buf.put(authBytes).put(0)
        buf.put(bodyBytes).put(0)

        val rawSig64 = try {
            val sig = Signature.getInstance("SHA256withECDSAinP1363Format")
            sig.initSign(keyPair.private)
            sig.update(buf.array())
            sig.sign()
        } catch (_: Exception) {
            val sig = Signature.getInstance("SHA256withECDSA")
            sig.initSign(keyPair.private)
            sig.update(buf.array())
            derToP1363(sig.sign())
        }

        val headerBuf = ByteBuffer.allocate(12 + 64)
        headerBuf.putInt(1)
        headerBuf.putLong(windowsTimestamp)
        headerBuf.put(rawSig64, 0, 64)
        return Base64.getEncoder().encodeToString(headerBuf.array())
    }

    private fun toUnsigned32Bytes(src: ByteArray): ByteArray {
        val out = ByteArray(32)
        if (src.size == 32) return src
        if (src.size > 32) {
            System.arraycopy(src, src.size - 32, out, 0, 32)
        } else {
            System.arraycopy(src, 0, out, 32 - src.size, src.size)
        }
        return out
    }

    private fun derToP1363(der: ByteArray): ByteArray {
        var offset = 2
        if (der[1].toInt() and 0x80 != 0) offset += (der[1].toInt() and 0x7F)
        offset++ // 0x02 tag for R
        val rLen = der[offset++].toInt() and 0xFF
        val rBytes = der.copyOfRange(offset, offset + rLen)
        offset += rLen
        offset++ // 0x02 tag for S
        val sLen = der[offset++].toInt() and 0xFF
        val sBytes = der.copyOfRange(offset, offset + sLen)

        val out = ByteArray(64)
        System.arraycopy(toUnsigned32Bytes(rBytes), 0, out, 0, 32)
        System.arraycopy(toUnsigned32Bytes(sBytes), 0, out, 32, 32)
        return out
    }
}

