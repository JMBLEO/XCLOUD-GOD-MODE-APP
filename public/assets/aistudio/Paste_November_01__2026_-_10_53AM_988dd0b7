                                colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF107C10))
                            ) {
                                Text("Reintentar con Bypass Regional Activo")
                            }
                        }
                    }
                    is AuthUiState.Success -> {
                        Text(
                            text = "✅ ¡Conectado como ${authState.session.gamertag}! Tier activo: ${authState.session.activeTier.label}",
                            color = Color(0xFF00E676),
                            fontWeight = FontWeight.Bold
                        )
                    }
                    else -> {}
                }

                if (activeTab == 1) {
                    Spacer(modifier = Modifier.height(14.dp))
                    Button(
                        onClick = onStartBrowserPkce,
                        colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF107C10)),
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Text("Abrir Navegador Seguro (Soporta Passkeys / Huella)")
                    }
                    Spacer(modifier = Modifier.height(10.dp))
                    OutlinedTextField(
                        value = pastedRedirect,
                        onValueChange = { pastedRedirect = it },
                        label = { Text("O pega aquí el enlace de retorno ms-xal://...") },
                        modifier = Modifier.fillMaxWidth()
                    )
                    if (pastedRedirect.isNotBlank()) {
                        Spacer(modifier = Modifier.height(8.dp))
                        Button(
                            onClick = { onManualRedirectPaste(pastedRedirect) },
                            modifier = Modifier.fillMaxWidth()
                        ) {
                            Text("Confirmar Código de Retorno")
                        }
                    }
                }
            }
        }
    }
}
5. Síntesis de Correcciones Frente a las CapturasLa integración conjunta de estos componentes resuelve de raíz los dos problemas observados en tus capturas:Prevención del falso "El código ha expirado" (13:22): El método pollDeviceCodeUntilAuthorized utiliza el endpoint https://login.microsoftonline.com/consumers/oauth2/v2.0/token con client_id = 1f907974-e22b-4810-a9de-d9647380c97e y evalúa explícitamente los estados authorization_pending y slow_down, manteniendo intacta la cuenta regresiva mientras el usuario autoriza el código en su smartphone.Resolución de "GSSV Login Failed HTTP 403": La función executeGssvCascadeWithReactiveBypass emplea los nombres de host globales (xgpuweb.gssv-play-prod.xboxlive.com, xgpuwebf2p.gssv-play-prod.xboxlive.com y xhome.gssv-play-prod.xboxlive.com), activa de forma reactiva la cabecera X-Forwarded-For ante bloqueos regionales (siguiendo el diseño de XFly y XCloud4) y conmuta automáticamente hacia Free-to-Play (xgpuwebf2p) o Consola Remota (xhome) cuando la cuenta no dispone de una suscripción activa a Game Pass Ultimate (siguiendo el diseño de green-nx).