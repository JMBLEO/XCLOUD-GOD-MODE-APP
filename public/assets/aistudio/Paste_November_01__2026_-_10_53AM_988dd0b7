class ProceduralUiSynth : public oboe::AudioStreamDataCallback {
private:
    std::atomic<float> frequency_{0.0f};
    std::atomic<float> amplitude_{0.0f};
    float phase_ = 0.0f;
    static constexpr int32_t kSampleRate = 48000;

public:
    void triggerTone(float freqHz, float initialAmp = 0.28f) {
        frequency_.store(freqHz, std::memory_order_relaxed);
        amplitude_.store(initialAmp, std::memory_order_relaxed);
    }

    oboe::DataCallbackResult onAudioReady(
        oboe::AudioStream *audioStream,
        void *audioData,
        int32_t numFrames
    ) override {
        float *output = static_cast<float *>(audioData);
        float freq = frequency_.load(std::memory_order_relaxed);
        float amp = amplitude_.load(std::memory_order_relaxed);
        const float phaseIncrement = (2.0f * static_cast<float>(M_PI) * freq) / kSampleRate;

        for (int i = 0; i < numFrames; ++i) {
            float sample = 0.0f;
            if (amp > 0.0005f) {
                sample = (std::sin(phase_) + 0.35f * std::sin(phase_ * 2.0f)) * amp;
                phase_ += phaseIncrement;
                if (phase_ > 2.0f * static_cast<float>(M_PI)) {
                    phase_ -= 2.0f * static_cast<float>(M_PI);
                }
                amp *= 0.9991f;
            }
            output[i * 2] = sample;
            output[i * 2 + 1] = sample;
        }
        amplitude_.store(amp, std::memory_order_relaxed);
        return oboe::DataCallbackResult::Continue;
    }
};

static ProceduralUiSynth gUiSynth;
static std::shared_ptr<oboe::AudioStream> gOboeStream;

